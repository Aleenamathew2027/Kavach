# KAVACH Frontend Environment Variables
# Obtain your Google OAuth 2.0 Client ID from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Backend API Base URL (defaults to http://127.0.0.1:8000 if not set)
VITE_API_BASE_URL=http://127.0.0.1:8000
