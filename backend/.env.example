# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kavach_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# Or full Database URL
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/kavach_db

# Predefined Administrator Credentials
ADMIN_EMAIL=admin@kavach.com
ADMIN_PASSWORD=KavachAdmin@123

# JWT Configuration
JWT_SECRET_KEY=your_secure_random_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google OAuth 2.0 / Google Identity Services Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
